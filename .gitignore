# ============================================================
#  Git 忽略规则 —— commerce-customer-service
#  生成于 2026-09-19
# ============================================================

# ---- 环境变量 / 密钥（最高优先级，绝对不要提交）----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python 虚拟环境（根目录 / 各子项目都有）
.venv/
venv/
ENV/
env/
.python-version

# 测试 / 类型检查 / lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ⚠️ 注意：uv.lock 和 pyproject.toml 应当【提交】—— 它们负责锁定依赖版本，
#    不要把 uv.lock 加进忽略列表。

# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ⚠️ 注意：package-lock.json 应当【提交】。

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
._*
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ---- WorkBuddy / AI 助手工作目录 ----
# 存放本地工作记忆（.workbuddy/memory/）。默认不提交；
# 若希望团队共享这些笔记，删掉下面这一行即可。
.workbuddy/

# ---- Kilo Code 工作目录 ----
# 内含 .kilo/worktrees/ —— 那是 git worktree 的完整项目副本（每个 = 一份 checkout），
# 提交进去会让仓库体积爆炸。必须忽略。
.kilo/

# ---- 保持目录结构（例：上传目录需要占位文件时）----
# !uploads/.gitkeep
